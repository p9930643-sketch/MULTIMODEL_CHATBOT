# Application Configuration
APP_NAME="Multimodal AI Companion"
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=multimodal_companion
# Optional full connection URL (if set, overrides individual fields)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/multimodal_companion
# SQLite fallback mode: enabled automatically when MySQL connection fails in dev/test
ALLOW_SQLITE_FALLBACK=True

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
